# --- Quy tắc dữ liệu test: docs/test-data-rules.md ---
# Giá trị thật (tên đăng nhập, mật khẩu) chỉ để trong .env. KHÔNG ghi vào file này, repo là public.
# Mật khẩu mới đặt khi test (TEST_NEW_USER_PASSWORD, TEST_TEMP_PASSWORD, TEST_RESET_PASSWORD) phải dài >= 8 ký tự.
TEST_DATA_PREFIX=AUTOTEST
TEST_IRN_PREFIX=2099
TEST_EMAIL_DOMAIN=@eiu.edu.vn
# Student thứ hai (TC-28 realtime). Bỏ trống nếu chưa có.
TEST_STUDENT2_IRN=
TEST_STUDENT2_PASSWORD=
# Chỉ cho kiểm thử thủ công TC-03/04/05 (docs/manual-tests): email trường @eiu.edu.vn và 1 Gmail ngoài trường
TEST_GOOGLE_EIU_EMAIL=
TEST_GOOGLE_OUTSIDE_EMAIL=

# Copy file này thành .env rồi điền giá trị thật. .env đã nằm trong .gitignore.
# Copy this file to .env and fill in real values. .env is already gitignored.
# Đặt file .env trong backend/ và chạy server từ thư mục backend/.

# Bắt buộc / Required — thiếu một trong hai thì app không khởi động (xem src/config/env.js).
DATABASE_URL=postgresql://user:password@host:6543/postgres
JWT_SECRET=sinh-bang-openssl-rand-hex-32
RUNNER=playwright

# Tùy chọn / Optional
# PORT=5000
# DB_SSL=true        # bắt buộc khi nối Supabase; Postgres local thường để trống
# DB_POOL_SIZE=5     # giữ nhỏ (1-5) để không vượt giới hạn kết nối của DB cloud
# INGEST_API_KEY=    # khóa GitHub Actions dùng để gọi /ingest/* (đặt cùng giá trị ở GitHub Secrets)

# Bộ chạy test / Test runner
# RUNNER=fake        # fake = giả lập log + kết quả (chỉ để dev local); github = chạy thật
#                    # Bỏ trống: có GITHUB_TOKEN → github, không có → fake. Production KHÔNG bao giờ dùng fake.
# GITHUB_TOKEN=      # fine-grained token, quyền Actions: write, chỉ cho repo này
# GITHUB_REPO=owner/repo
# GITHUB_WORKFLOW=run-tests.yml
# GITHUB_REF=main

# RUNNER=playwright: chạy thật ngay trong backend, CHỈ DÙNG LOCAL (Vercel không có chromium).
# BASE_URL=http://localhost:5173          # tên cũ, vẫn được nhận là môi trường development
# Môi trường chọn lúc bấm Run quyết định web đích. Khai biến cho môi trường nào thì
# môi trường đó mới hiện ở GET /meta/options và mới POST /runs được (thiếu → 400).
# Bên GitHub Actions cần secret CÙNG TÊN (workflow đọc BASE_URL_<MÔI TRƯỜNG>).
# BASE_URL_DEVELOPMENT=http://localhost:5173
# BASE_URL_TESTING=https://testing.example.edu.vn
# BASE_URL_STAGING=https://staging.example.edu.vn
# BASE_URL_PRODUCTION=https://example.edu.vn
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium
# Tài khoản test: test_data trỏ 'env:TEN_BIEN', giá trị thật đặt ở đây (local) hoặc GitHub Secrets (CI).
# TEST_STUDENT_IRN=
# TEST_STUDENT_PASSWORD=
# TEST_LECTURER_IRN=
# TEST_LECTURER_PASSWORD=

# DEV_LOG_RESET_TOKEN=true   # chỉ dev: in token quên mật khẩu ra console (bị bỏ qua khi NODE_ENV=production)

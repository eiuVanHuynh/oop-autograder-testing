# Copy file này thành .env rồi điền giá trị thật. .env đã nằm trong .gitignore.
# Copy this file to .env and fill in real values. .env is already gitignored.
# Đặt file .env trong backend/ và chạy server từ thư mục backend/.

# Bắt buộc / Required — thiếu một trong hai thì app không khởi động (xem src/config/env.js).
DATABASE_URL=postgresql://user:pass@localhost:5432/test_automation_db
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-du-dai

# Tùy chọn / Optional
# PORT=5000
# DB_SSL=true        # bắt buộc khi nối Supabase; Postgres local thường để trống
# DB_POOL_SIZE=5     # giữ nhỏ (1-5) để không vượt giới hạn kết nối của DB cloud
# INGEST_API_KEY=    # chỉ cần khi làm nhóm /ingest

# Bộ chạy test / Test runner
# RUNNER=fake        # fake = giả lập log + kết quả (chỉ để dev local); github = chạy thật
#                    # Bỏ trống: có GITHUB_TOKEN → github, không có → fake. Production KHÔNG bao giờ dùng fake.
# GITHUB_TOKEN=      # fine-grained token, quyền Actions: write, chỉ cho repo này
# GITHUB_REPO=owner/repo
# GITHUB_WORKFLOW=run-tests.yml
# GITHUB_REF=main

# DEV_LOG_RESET_TOKEN=true   # chỉ dev: in token quên mật khẩu ra console (bị bỏ qua khi NODE_ENV=production)

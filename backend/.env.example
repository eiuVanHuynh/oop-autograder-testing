# Copy this file to .env and fill in real values. .env is already gitignored.
# Put the .env file in backend/ and run the server from the backend/ directory.

# Required — without either of these the app will not start (see src/config/env.js).
DATABASE_URL=postgresql://user:password@host:6543/postgres
JWT_SECRET=generate-with-openssl-rand-hex-32
RUNNER=playwright

# Optional
# PORT=5000
# DB_SSL=true        # required for Supabase; usually left empty for local Postgres
# DB_POOL_SIZE=5     # keep it small (1-5) to stay under the cloud DB connection limit
# DB_LOG=true        # print one line per SQL query (off by default; errors are always printed)
# INGEST_API_KEY=    # the key GitHub Actions uses to call /ingest/* (set the same value in GitHub Secrets)

# Test runner
# RUNNER=fake        # fake = simulated logs + results (local dev only); github = a real run
#                    # Empty: GITHUB_TOKEN present → github, absent → fake. Production must NEVER use fake.
# GITHUB_TOKEN=      # fine-grained token, Actions: write, for this repo only
# GITHUB_REPO=owner/repo
# GITHUB_WORKFLOW=run-tests.yml
# GITHUB_REF=main

# RUNNER=playwright: a real run inside the backend, LOCAL USE ONLY (Vercel has no chromium).
# BASE_URL=http://localhost:5173          # old name, still accepted as the development environment
# The environment picked when pressing Run decides the target site. An environment only appears in
# GET /meta/options and only works with POST /runs once its variable is declared (missing → 400).
# GitHub Actions needs a secret with the SAME NAME (the workflow reads BASE_URL_<ENVIRONMENT>).
# BASE_URL_DEVELOPMENT=http://localhost:5173
# BASE_URL_TESTING=https://testing.example.edu.vn
# BASE_URL_STAGING=https://staging.example.edu.vn
# BASE_URL_PRODUCTION=https://example.edu.vn
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium
# Test accounts: test_data points at 'env:VAR_NAME', the real values go here (local) or in GitHub Secrets (CI).
# TEST_STUDENT_IRN=
# TEST_STUDENT_PASSWORD=
# TEST_LECTURER_IRN=
# TEST_LECTURER_PASSWORD=

# DEV_LOG_RESET_TOKEN=true   # dev only: print the forgot-password token to the console (ignored when NODE_ENV=production)
